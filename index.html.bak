<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MMI SoundBoard 🎵</title>
  <meta name="description" content="Tableau de bord sonore interactif – importez vos MP3 et créez vos buzzers personnalisés." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* ─── DESIGN TOKENS ─── */
    :root {
      --bg:        #0a0b14;
      --surface:   #12141f;
      --surface2:  #1a1d2e;
      --border:    rgba(255,255,255,0.07);
      --accent:    #7c5cfc;
      --accent2:   #e040fb;
      --accent3:   #00e5ff;
      --text:      #e8eaf6;
      --muted:     #6b6f8a;
      --danger:    #ff4560;
      --success:   #00e676;
      --radius:    14px;
      --shadow:    0 8px 32px rgba(0,0,0,0.5);
    }

    /* ─── RESET ─── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'Outfit', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ─── BACKGROUND GLOW ─── */
    body::before {
      content: '';
      position: fixed;
      top: -200px; left: -200px;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(124,92,252,0.15) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }
    body::after {
      content: '';
      position: fixed;
      bottom: -200px; right: -200px;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(224,64,251,0.1) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    /* ─── LAYOUT ─── */
    .wrapper {
      position: relative; z-index: 1;
      max-width: 1100px;
      margin: 0 auto;
      padding: 40px 24px 80px;
    }

    /* ─── HEADER ─── */
    header {
      text-align: center;
      margin-bottom: 48px;
    }
    .logo {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-size: 2.8rem;
      font-weight: 800;
      letter-spacing: -1px;
      line-height: 1;
    }
    .logo-icon {
      font-size: 2.4rem;
      -webkit-text-fill-color: initial;
    }
    header p {
      color: var(--muted);
      margin-top: 10px;
      font-size: 1rem;
      font-weight: 400;
    }

    /* ─── STATS BAR ─── */
    .stats-bar {
      display: flex;
      gap: 16px;
      justify-content: center;
      margin-bottom: 40px;
      flex-wrap: wrap;
    }
    .stat-chip {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 50px;
      padding: 8px 20px;
      font-size: 0.85rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .stat-chip span { color: var(--text); font-weight: 600; }

    /* ─── UPLOAD ZONE ─── */
    .upload-section {
      background: var(--surface);
      border: 2px dashed var(--border);
      border-radius: var(--radius);
      padding: 36px 24px;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.25s, background 0.25s, transform 0.2s;
      margin-bottom: 40px;
      position: relative;
      overflow: hidden;
    }
    .upload-section::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(124,92,252,0.04), rgba(224,64,251,0.04));
      opacity: 0;
      transition: opacity 0.3s;
    }
    .upload-section:hover,
    .upload-section.drag-over {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .upload-section:hover::before,
    .upload-section.drag-over::before { opacity: 1; }
    .upload-section.drag-over { border-color: var(--accent2); background: rgba(224,64,251,0.05); }

    .upload-icon {
      font-size: 3rem;
      margin-bottom: 12px;
      display: block;
      animation: float 3s ease-in-out infinite;
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
    .upload-title {
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 6px;
    }
    .upload-sub {
      font-size: 0.85rem;
      color: var(--muted);
      margin-bottom: 20px;
    }

    /* ─── RENAME INPUT ─── */
    .upload-form {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }
    .upload-row {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      max-width: 480px;
    }
    .input-field {
      flex: 1;
      min-width: 180px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 16px;
      color: var(--text);
      font-family: 'Outfit', sans-serif;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .input-field:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(124,92,252,0.15);
    }
    .input-field::placeholder { color: var(--muted); }

    /* ─── EMOJI PICKER ─── */
    .emoji-picker {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 4px;
    }
    .emoji-btn {
      background: var(--surface2);
      border: 1.5px solid transparent;
      border-radius: 8px;
      width: 38px; height: 38px;
      font-size: 1.3rem;
      cursor: pointer;
      transition: border-color 0.15s, transform 0.15s, background 0.15s;
      display: flex; align-items: center; justify-content: center;
    }
    .emoji-btn:hover { background: var(--surface); transform: scale(1.15); }
    .emoji-btn.selected { border-color: var(--accent); background: rgba(124,92,252,0.18); }

    /* ─── COLOR PICKER ROW ─── */
    .color-row {
      display: flex;
      gap: 8px;
      align-items: center;
      justify-content: center;
    }
    .color-swatch {
      width: 28px; height: 28px;
      border-radius: 50%;
      border: 2.5px solid transparent;
      cursor: pointer;
      transition: transform 0.15s, border-color 0.15s;
    }
    .color-swatch:hover { transform: scale(1.2); }
    .color-swatch.selected { border-color: #fff; transform: scale(1.15); }

    /* ─── BUTTONS ─── */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      border-radius: 10px;
      font-family: 'Outfit', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: transform 0.15s, box-shadow 0.2s, filter 0.15s;
    }
    .btn:active { transform: scale(0.96); }
    .btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff;
      box-shadow: 0 4px 20px rgba(124,92,252,0.35);
    }
    .btn-primary:hover { box-shadow: 0 6px 28px rgba(124,92,252,0.5); filter: brightness(1.1); }
    .btn-ghost {
      background: var(--surface2);
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
    .btn-danger {
      background: rgba(255,69,96,0.12);
      color: var(--danger);
      border: 1px solid rgba(255,69,96,0.2);
    }
    .btn-danger:hover { background: rgba(255,69,96,0.22); }

    /* ─── FILE INPUT HIDDEN ─── */
    #fileInput { display: none; }

    /* ─── SECTION HEADER ─── */
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
      gap: 12px;
      flex-wrap: wrap;
    }
    .section-title {
      font-size: 1.3rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .badge {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff;
      border-radius: 50px;
      padding: 3px 12px;
      font-size: 0.8rem;
      font-weight: 700;
    }

    /* ─── SEARCH ─── */
    .search-wrap {
      position: relative;
      flex: 1;
      max-width: 240px;
    }
    .search-icon {
      position: absolute;
      left: 12px; top: 50%;
      transform: translateY(-50%);
      font-size: 1rem;
      color: var(--muted);
      pointer-events: none;
    }
    #searchInput {
      width: 100%;
      padding: 10px 14px 10px 36px;
    }

    /* ─── BUZZER GRID ─── */
    .buzzer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 18px;
    }

    /* ─── BUZZER CARD ─── */
    .buzzer-card {
      position: relative;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px 16px 20px;
      text-align: center;
      cursor: pointer;
      transition: transform 0.18s, box-shadow 0.2s, border-color 0.2s;
      overflow: hidden;
      user-select: none;
    }
    .buzzer-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--card-color, linear-gradient(135deg, rgba(124,92,252,0.08), rgba(0,229,255,0.05)));
      opacity: 0.6;
      transition: opacity 0.25s;
    }
    .buzzer-card:hover {
      transform: translateY(-4px) scale(1.02);
      box-shadow: 0 12px 40px rgba(0,0,0,0.4);
      border-color: rgba(255,255,255,0.15);
    }
    .buzzer-card:hover::before { opacity: 1; }
    .buzzer-card:active { transform: scale(0.97); }

    .buzzer-card.playing {
      animation: pulse-card 0.4s ease;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(124,92,252,0.25), 0 12px 40px rgba(0,0,0,0.4);
    }
    @keyframes pulse-card {
      0%   { transform: scale(1); }
      40%  { transform: scale(1.06); }
      100% { transform: scale(1); }
    }

    .buzzer-emoji {
      font-size: 2.5rem;
      display: block;
      margin-bottom: 10px;
      position: relative;
      z-index: 1;
      transition: transform 0.2s;
    }
    .buzzer-card:hover .buzzer-emoji { transform: scale(1.2) rotate(5deg); }

    .buzzer-name {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text);
      position: relative; z-index: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .buzzer-duration {
      font-size: 0.72rem;
      color: var(--muted);
      position: relative; z-index: 1;
      margin-top: 4px;
    }

    /* Playing wave indicator */
    .wave-indicator {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 3px;
      height: 20px;
      margin-top: 8px;
      opacity: 0;
      transition: opacity 0.2s;
      position: relative; z-index: 1;
    }
    .buzzer-card.playing .wave-indicator { opacity: 1; }
    .wave-bar {
      width: 4px;
      background: var(--accent);
      border-radius: 2px;
      animation: wave-anim 0.8s ease-in-out infinite;
    }
    .wave-bar:nth-child(2) { animation-delay: 0.1s; background: var(--accent2); }
    .wave-bar:nth-child(3) { animation-delay: 0.2s; }
    .wave-bar:nth-child(4) { animation-delay: 0.05s; background: var(--accent2); }
    @keyframes wave-anim {
      0%, 100% { height: 4px; }
      50% { height: 16px; }
    }



    /* ─── EDIT BUTTON ON CARD ─── */
    .card-edit {
      position: absolute;
      top: 8px; left: 8px;
      background: rgba(124,92,252,0.12);
      border: none;
      border-radius: 6px;
      width: 26px; height: 26px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.75rem;
      color: var(--accent);
      cursor: pointer;
      opacity: 0;
      transition: opacity 0.2s, background 0.15s;
      z-index: 10;
    }
    .buzzer-card:hover .card-edit { opacity: 1; }
    .card-edit:hover { background: rgba(124,92,252,0.28); }

    /* ─── EMPTY STATE ─── */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: var(--muted);
      grid-column: 1 / -1;
    }
    .empty-state .icon { font-size: 3.5rem; margin-bottom: 16px; opacity: 0.5; }
    .empty-state p { font-size: 0.95rem; }

    /* ─── TOAST ─── */
    .toast-container {
      position: fixed;
      bottom: 30px; right: 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 1000;
    }
    .toast {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px 20px;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: var(--shadow);
      animation: slide-in 0.3s ease forwards;
      max-width: 320px;
    }
    .toast.success { border-color: rgba(0,230,118,0.3); }
    .toast.error   { border-color: rgba(255,69,96,0.3); }
    @keyframes slide-in {
      from { transform: translateX(100px); opacity: 0; }
      to   { transform: translateX(0);     opacity: 1; }
    }
    @keyframes slide-out {
      from { transform: translateX(0);     opacity: 1; }
      to   { transform: translateX(100px); opacity: 0; }
    }

    /* ─── MODAL ─── */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.75);
      backdrop-filter: blur(6px);
      display: flex; align-items: center; justify-content: center;
      z-index: 500;
      opacity: 0; pointer-events: none;
      transition: opacity 0.25s;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }
    .modal {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px;
      width: 90%;
      max-width: 460px;
      box-shadow: var(--shadow);
      transform: translateY(20px) scale(0.96);
      transition: transform 0.25s;
    }
    .modal-overlay.open .modal { transform: none; }
    .modal h2 {
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 24px;
      display: flex; align-items: center; gap: 10px;
    }
    .modal-form { display: flex; flex-direction: column; gap: 16px; }
    .modal-label { font-size: 0.82rem; color: var(--muted); margin-bottom: 6px; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; }
    .modal-actions { display: flex; gap: 12px; margin-top: 8px; justify-content: flex-end; }

    /* ─── VOLUME SLIDER ─── */
    .volume-row {
      display: flex; align-items: center; gap: 12px;
      margin-top: 8px;
    }
    .volume-row label { font-size: 0.85rem; color: var(--muted); white-space: nowrap; }
    input[type=range] {
      flex: 1;
      -webkit-appearance: none;
      height: 4px;
      background: var(--surface2);
      border-radius: 2px;
      outline: none;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 16px; height: 16px;
      border-radius: 50%;
      background: var(--accent);
      cursor: pointer;
      box-shadow: 0 0 6px rgba(124,92,252,0.4);
    }

    /* ─── FOOTER ─── */
    footer {
      text-align: center;
      padding-top: 40px;
      color: var(--muted);
      font-size: 0.8rem;
    }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 600px) {
      .logo { font-size: 2rem; }
      .buzzer-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); }
    }
  </style>
</head>
<body>

<div class="wrapper">

  <!-- HEADER -->
  <header>
    <div class="logo">
      <span class="logo-icon">🎛️</span>
      MMI SoundBoard
    </div>
    <p>Importez vos MP3 et jouez vos sons en un clic</p>
  </header>

  <!-- STATS -->
  <div class="stats-bar">
    <div class="stat-chip">🎵 Sons enregistrés : <span id="statCount">0</span></div>
    <div class="stat-chip">💾 Stockage utilisé : <span id="statStorage">0 Ko</span></div>
    <div class="stat-chip">🕐 Son joué : <span id="statLast">–</span></div>
  </div>

  <!-- UPLOAD ZONE -->
  <div class="upload-section" id="uploadZone">
    <span class="upload-icon">🎵</span>
    <div class="upload-title">Déposez vos fichiers MP3 ici</div>
    <div class="upload-sub">ou cliquez pour sélectionner · MP3, WAV, OGG acceptés</div>

    <div class="upload-form">
      <div class="upload-row">
        <input type="text" class="input-field" id="soundName" placeholder="Nom du son (optionnel)" />
      </div>

      <div>
        <div class="modal-label" style="margin-bottom:8px;">Choisir un emoji</div>
        <div class="emoji-picker" id="emojiPicker"></div>
      </div>

      <div>
        <div class="modal-label" style="margin-bottom:8px;">Couleur du bouton</div>
        <div class="color-row" id="colorPicker"></div>
      </div>

      <div class="upload-row" style="justify-content: center;">
        <button class="btn btn-primary" id="browseBtn" type="button">
          <span>📂</span> Choisir un fichier
        </button>
      </div>
    </div>

    <input type="file" id="fileInput" accept="audio/*" multiple />
  </div>

  <!-- BUZZER SECTION -->
  <div class="section-header">
    <div class="section-title">
      🎤 Mes Buzzers
      <span class="badge" id="buzzerBadge">0</span>
    </div>
    <div class="search-wrap">
      <span class="search-icon">🔍</span>
      <input type="text" class="input-field" id="searchInput" placeholder="Rechercher..." />
    </div>
  </div>

  <div class="buzzer-grid" id="buzzerGrid">
    <div class="empty-state">
      <div class="icon">🎧</div>
      <p>Aucun son pour l'instant.<br>Ajoutez votre premier fichier MP3 !</p>
    </div>
  </div>

  <footer>MMI SoundBoard &copy; 2026 · Sons stockés localement dans votre navigateur</footer>
</div>

<!-- TOAST CONTAINER -->
<div class="toast-container" id="toastContainer"></div>

<!-- EDIT MODAL -->
<div class="modal-overlay" id="editModal">
  <div class="modal">
    <h2>✏️ Modifier le son</h2>
    <div class="modal-form">
      <div>
        <div class="modal-label">Nom du son</div>
        <input type="text" class="input-field" id="editName" style="width:100%" />
      </div>
      <div>
        <div class="modal-label">Emoji</div>
        <div class="emoji-picker" id="editEmojiPicker"></div>
      </div>
      <div>
        <div class="modal-label">Couleur</div>
        <div class="color-row" id="editColorPicker"></div>
      </div>
      <div class="volume-row">
        <label>🔊 Volume</label>
        <input type="range" id="editVolume" min="0" max="100" value="100" />
        <span id="editVolumePct" style="font-size:0.85rem;color:var(--muted);min-width:34px">100%</span>
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="editCancel">Annuler</button>
      <button class="btn btn-primary" id="editSave">💾 Enregistrer</button>
    </div>
  </div>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.10.0/firebase-app.js";
import { getFirestore, collection, addDoc, onSnapshot, doc, setDoc } from "https://www.gstatic.com/firebasejs/10.10.0/firebase-firestore.js";
import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/10.10.0/firebase-storage.js";

/* ═══════════════════════════════════════════════
   MMI SoundBoard — Firebase Cloud Shared Edition
   ═══════════════════════════════════════════════ */

// 🔸 REMPLACEZ CECI PAR VOTRE CONFIGURATION FIREBASE 🔸
const firebaseConfig = {
  apiKey: "VOTRE_API_KEY",
  authDomain: "VOTRE_PROJET.firebaseapp.com",
  projectId: "VOTRE_PROJET",
  storageBucket: "VOTRE_PROJET.appspot.com",
  messagingSenderId: "VOTRE_MESSAGING_SENDER_ID",
  appId: "VOTRE_APP_ID"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);
const storage = getStorage(app);

const EMOJIS  = ['🎵','🎶','🔔','🎸','🥁','🎹','🎺','🎻','🎙','📯','🔊','💥','🎉','🚨','🌊','🌟','🔥','💫','🎮','🕹'];
const COLORS  = [
  { name: 'purple', val: 'linear-gradient(135deg,rgba(124,92,252,0.15),rgba(224,64,251,0.08))' },
  { name: 'cyan',   val: 'linear-gradient(135deg,rgba(0,229,255,0.14),rgba(0,176,255,0.07))' },
  { name: 'green',  val: 'linear-gradient(135deg,rgba(0,230,118,0.14),rgba(0,191,165,0.07))' },
  { name: 'orange', val: 'linear-gradient(135deg,rgba(255,167,38,0.14),rgba(255,109,0,0.07))' },
  { name: 'pink',   val: 'linear-gradient(135deg,rgba(236,64,122,0.14),rgba(255,64,129,0.07))' },
  { name: 'red',    val: 'linear-gradient(135deg,rgba(255,69,96,0.14),rgba(211,47,47,0.07))' },
  { name: 'yellow', val: 'linear-gradient(135deg,rgba(255,235,59,0.14),rgba(255,193,7,0.07))' },
  { name: 'mono',   val: 'linear-gradient(135deg,rgba(255,255,255,0.06),rgba(200,200,200,0.03))' },
];
const COLOR_SWATCHES = ['#7c5cfc','#00e5ff','#00e676','#ffa726','#ec407a','#ff4560','#ffeb3b','#aab4d0'];

let sounds = [];     // in-memory cache
let selectedEmoji  = EMOJIS[0];
let selectedColor  = COLORS[0].val;
let editEmoji      = EMOJIS[0];
let editColor      = COLORS[0].val;
let editingId      = null;
let currentAudio   = null;
let currentCardEl  = null;

/* ── Format bytes ── */
function fmtBytes(b) {
  if (b < 1024) return b + ' o';
  if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' Ko';
  return (b / (1024 * 1024)).toFixed(2) + ' Mo';
}

/* ── Toast ── */
function toast(msg, type = 'success') {
  const icon = type === 'success' ? '✅' : type === 'error' ? '❌' : 'ℹ️';
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  el.innerHTML = `<span>${icon}</span><span>${msg}</span>`;
  document.getElementById('toastContainer').appendChild(el);
  setTimeout(() => {
    el.style.animation = 'slide-out 0.3s ease forwards';
    setTimeout(() => el.remove(), 300);
  }, 3000);
}

/* ── Build emoji pickers ── */
function buildEmojiPicker(containerId, current, onSelect) {
  const container = document.getElementById(containerId);
  container.innerHTML = '';
  EMOJIS.forEach(emoji => {
    const btn = document.createElement('button');
    btn.className = 'emoji-btn' + (emoji === current ? ' selected' : '');
    btn.textContent = emoji;
    btn.type = 'button';
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      container.querySelectorAll('.emoji-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      onSelect(emoji);
    });
    container.appendChild(btn);
  });
}

function buildColorPicker(containerId, current, onSelect) {
  const container = document.getElementById(containerId);
  container.innerHTML = '';
  COLORS.forEach((c, i) => {
    const sw = document.createElement('button');
    sw.className = 'color-swatch' + (c.val === current ? ' selected' : '');
    sw.style.background = COLOR_SWATCHES[i];
    sw.title = c.name;
    sw.type = 'button';
    sw.addEventListener('click', (e) => {
      e.stopPropagation();
      container.querySelectorAll('.color-swatch').forEach(b => b.classList.remove('selected'));
      sw.classList.add('selected');
      onSelect(c.val);
    });
    container.appendChild(sw);
  });
}

/* ── Stats ── */
function updateStats() {
  document.getElementById('statCount').textContent = sounds.length;
  const totalBytes = sounds.reduce((acc, s) => acc + (s.size || 0), 0);
  document.getElementById('statStorage').textContent = fmtBytes(totalBytes);
  document.getElementById('buzzerBadge').textContent = sounds.length;
}

/* ── Render ── */
function renderGrid(filter = '') {
  const grid = document.getElementById('buzzerGrid');
  const filtered = sounds.filter(s =>
    s.name.toLowerCase().includes(filter.toLowerCase())
  );

  if (filtered.length === 0) {
    grid.innerHTML = `
      <div class="empty-state">
        <div class="icon">${filter ? '🔍' : '🎧'}</div>
        <p>${filter ? 'Aucun résultat pour "' + filter + '"' : 'Aucun son pour l\'instant.<br>Ajoutez votre premier fichier MP3 !'}</p>
      </div>`;
    return;
  }

  grid.innerHTML = '';
  filtered.forEach(sound => {
    const card = document.createElement('div');
    card.className = 'buzzer-card';
    card.dataset.id = sound.id;
    card.style.setProperty('--card-color', sound.color || COLORS[0].val);

    card.innerHTML = `
      <button class="card-edit" title="Modifier" data-id="${sound.id}">✏️</button>
      <span class="buzzer-emoji">${sound.emoji || '🎵'}</span>
      <div class="buzzer-name">${sound.name}</div>
      <div class="buzzer-duration">${sound.duration ? sound.duration + 's' : '–'}</div>
      <div class="wave-indicator">
        <div class="wave-bar"></div>
        <div class="wave-bar"></div>
        <div class="wave-bar"></div>
        <div class="wave-bar"></div>
      </div>`;

    // Play sound on card click (not on buttons)
    card.addEventListener('click', (e) => {
      if (e.target.closest('.card-edit')) return;
      playSound(sound, card);
    });

    // Edit
    card.querySelector('.card-edit').addEventListener('click', (e) => {
      e.stopPropagation();
      openEditModal(sound);
    });

    grid.appendChild(card);
  });
}

/* ── Play ── */
function playSound(sound, cardEl) {
  // Stop previous
  if (currentAudio) {
    currentAudio.pause();
    currentAudio.currentTime = 0;
  }
  if (currentCardEl) currentCardEl.classList.remove('playing');

  const audio = new Audio(sound.url);
  audio.volume = (sound.volume ?? 100) / 100;

  currentAudio  = audio;
  currentCardEl = cardEl;
  cardEl.classList.add('playing');

  document.getElementById('statLast').textContent = sound.name;

  audio.play().catch(() => toast('Impossible de lire ce son', 'error'));
  audio.onended = () => {
    cardEl.classList.remove('playing');
    currentAudio = null; currentCardEl = null;
  };
}

/* ── Get audio duration ── */
function getAudioDuration(arrayBuffer, type) {
  return new Promise(resolve => {
    const blob = new Blob([arrayBuffer], { type });
    const url  = URL.createObjectURL(blob);
    const a    = new Audio(url);
    a.onloadedmetadata = () => {
      URL.revokeObjectURL(url);
      resolve(isFinite(a.duration) ? Math.round(a.duration) : null);
    };
    a.onerror = () => { URL.revokeObjectURL(url); resolve(null); };
  });
}

/* ── Import files ── */
async function importFiles(files) {
  const nameInput = document.getElementById('soundName');
  let imported = 0;

  for (const file of files) {
    if (!file.type.startsWith('audio/')) { toast(`${file.name} n'est pas un fichier audio`, 'error'); continue; }

    const arrayBuffer = await file.arrayBuffer();
    const duration    = await getAudioDuration(arrayBuffer, file.type);
    const customName  = nameInput.value.trim();
    const name        = customName || file.name.replace(/\.[^/.]+$/, '');

    // Vérification de doublon (même nom ou même taille de fichier)
    const isDuplicate = sounds.some(s => s.size === file.size || s.name.toLowerCase() === name.toLowerCase());
    if (isDuplicate) {
      toast(`Le son "${name}" (ou un fichier identique) existe déjà`, 'error');
      continue;
    }

    toast(`⏳ Envoi de "${name}" sur le cloud...`, 'info');

    try {
      const fileRef = ref(storage, 'sounds/' + Date.now() + '_' + file.name);
      await uploadBytes(fileRef, file);
      const url = await getDownloadURL(fileRef);

      const soundData = {
        name,
        type:     file.type,
        size:     file.size,
        duration,
        emoji:    selectedEmoji,
        color:    selectedColor,
        volume:   100,
        url:      url,
        addedAt:  new Date().toISOString(),
      };

      await addDoc(collection(db, "sounds"), soundData);
      imported++;
      nameInput.value = '';
    } catch (err) {
      console.error(err);
      toast(`❌ Erreur d'envoi pour "${name}"`, 'error');
    }
  }

  if (imported > 0) {
    toast(`✨ ${imported} son${imported > 1 ? 's' : ''} envoyé${imported > 1 ? 's' : ''} sur le cloud !`);
  }
}

/* ── Edit Modal ── */
function openEditModal(sound) {
  editingId  = sound.id;
  editEmoji  = sound.emoji  || EMOJIS[0];
  editColor  = sound.color  || COLORS[0].val;

  document.getElementById('editName').value  = sound.name;
  document.getElementById('editVolume').value = sound.volume ?? 100;
  document.getElementById('editVolumePct').textContent = (sound.volume ?? 100) + '%';

  buildEmojiPicker('editEmojiPicker', editEmoji, v => { editEmoji = v; });
  buildColorPicker('editColorPicker', editColor, v => { editColor = v; });

  document.getElementById('editModal').classList.add('open');
}

async function saveEdit() {
  const sound = sounds.find(s => s.id === editingId);
  if (!sound) return;

  try {
    const soundRef = doc(db, "sounds", editingId);
    await setDoc(soundRef, {
      name: document.getElementById('editName').value.trim() || sound.name,
      emoji: editEmoji,
      color: editColor,
      volume: parseInt(document.getElementById('editVolume').value)
    }, { merge: true });

    closeEditModal();
    toast('Son modifié pour tout le monde !');
  } catch (err) {
    console.error(err);
    toast('Erreur de modification', 'error');
  }
}

function closeEditModal() {
  document.getElementById('editModal').classList.remove('open');
  editingId = null;
}

/* ── Init ── */
async function init() {
  const soundsCol = collection(db, "sounds");
  onSnapshot(soundsCol, (snapshot) => {
    sounds = [];
    snapshot.forEach((doc) => {
      sounds.push({ id: doc.id, ...doc.data() });
    });
    sounds.sort((a, b) => new Date(a.addedAt) - new Date(b.addedAt));
    renderGrid(document.getElementById('searchInput').value);
    updateStats();
  });

  buildEmojiPicker('emojiPicker', selectedEmoji, v => { selectedEmoji = v; });
  buildColorPicker('colorPicker', selectedColor, v => { selectedColor = v; });
  buildEmojiPicker('editEmojiPicker', editEmoji, v => { editEmoji = v; });
  buildColorPicker('editColorPicker', editColor, v => { editColor = v; });

  /* ─ Upload zone events ─ */
  const zone = document.getElementById('uploadZone');
  const fileInput = document.getElementById('fileInput');

  document.getElementById('browseBtn').addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput.click();
  });

  zone.addEventListener('click', () => fileInput.click());

  fileInput.addEventListener('change', () => {
    if (fileInput.files.length) importFiles(Array.from(fileInput.files));
    fileInput.value = '';
  });

  zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('drag-over'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
  zone.addEventListener('drop', (e) => {
    e.preventDefault();
    zone.classList.remove('drag-over');
    const files = Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('audio/'));
    if (files.length) importFiles(files);
  });

  /* ─ Search ─ */
  document.getElementById('searchInput').addEventListener('input', (e) => {
    renderGrid(e.target.value);
  });

  /* ─ Edit modal ─ */
  document.getElementById('editCancel').addEventListener('click', closeEditModal);
  document.getElementById('editSave').addEventListener('click', saveEdit);
  document.getElementById('editModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('editModal')) closeEditModal();
  });

  /* ─ Volume slider preview ─ */
  document.getElementById('editVolume').addEventListener('input', (e) => {
    document.getElementById('editVolumePct').textContent = e.target.value + '%';
  });

  /* ─ Prevent upload-form clicks from triggering file dialog ─ */
  document.querySelector('.upload-form').addEventListener('click', e => e.stopPropagation());

  /* ─ Keyboard shortcut: Escape closes modal ─ */
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeEditModal();
  });
}

init().catch(err => {
  console.error(err);
  toast('Erreur d\'initialisation de la base de données', 'error');
});
</script>
</body>
</html>